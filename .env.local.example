# MongoDB - Use MongoDB Atlas (free tier available)
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dsa-sync?retryWrites=true&w=majority

# JWT Secret - Generate a secure random key
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Groq AI API Key - Get from: https://console.groq.com
# Free tier available with fast Llama models
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API Key (for the Floating AI Assistant)
OPENAI_API_KEY="your_openai_api_key_here"

# Stripe API Keys (for Premium Companywise feature)
# Get these from your Stripe Dashboard (Developers -> API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App URL - Your deployment URL (use localhost:3000 for development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider - Currently using Groq (do not change)
AI_PROVIDER=groq

# ========================
# PUSH NOTIFICATIONS (NEW!)
# ========================
# VAPID Keys for Web Push Notifications (Legacy)
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_public_key_here

# Firebase Cloud Messaging Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Firebase Admin SDK (Server-Side)
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="your_private_key"

# Admin Email - Used for VAPID subject
ADMIN_EMAIL=admin@yourdomain.com

# ========================
# SECURITY SECRETS (NEW!)
# ========================
# Cron Secret - Protects automated notification endpoints
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-secure-random-cron-secret-key

# Admin Secret - Protects admin endpoints
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-secure-random-admin-secret-key
